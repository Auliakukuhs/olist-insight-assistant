# Salin menjadi .env untuk menjalankan lokal. Jangan commit .env.
# Di AWS, nilai ini disuntik lewat environment saat runtime, tidak lewat image.

APP_ENV=local

# Bila diisi, semua endpoint kecuali /health mewajibkan header X-API-Key
API_ACCESS_KEY=

# Login. Kosongkan AUTH_SECRET untuk mematikan login (peran dari body request).
# Isi AUTH_SECRET dengan string acak panjang, misalnya hasil
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Ganti semua password di bawah. seller_id milik seller dengan penjualan terbesar.
AUTH_SECRET=
DEMO_USERS='{"admin": {"password": "ganti-ini", "peran": "admin"}, "seller": {"password": "ganti-ini", "peran": "seller", "seller_id": "4869f7a5dfa277a7dca6462dcf3b52b2"}, "customer": {"password": "ganti-ini", "peran": "customer"}}'

OPENAI_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
