# Salin menjadi .env untuk menjalankan lokal. Jangan commit .env.
# Di AWS, nilai ini disuntik lewat environment saat runtime, tidak lewat image.

APP_ENV=local

# Bila diisi, POST /chat mewajibkan header X-API-Key dengan nilai ini
API_ACCESS_KEY=

OPENAI_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
